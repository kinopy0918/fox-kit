{
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(sqlite3:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(rsync:*)",
      "Bash(pkill:*)",
      "Bash(osascript:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(rm:*)",
      "Bash(open:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(ps:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-output-location.py",
            "timeout": 10,
            "statusMessage": "置き場チェック"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-dangerous-ops.py",
            "timeout": 10,
            "statusMessage": "安全ガード"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-secret-commit.py",
            "timeout": 15,
            "statusMessage": "秘密の持ち出しチェック"
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
